{
  "name": "toraja-coffee",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "prisma:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
